{
  "name": "watis",
  "version": "0.1.0",
  "description": "Desktop client for WhatsApp Web with a local searchable archive",
  "license": "MIT",
  "author": "phish3144",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phish3144/watis.git"
  },
  "type": "commonjs",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke:sqlite": "node scripts/smoke-sqlite.mjs",
    "loadtest:archive": "node scripts/loadtest-archive.mjs",
    "package": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:win:unpacked": "npm run build && electron-builder --win --dir",
    "dist:win:prepackaged": "electron-builder --win --prepackaged release/win-unpacked --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "verify:no-elevate": "node scripts/verify-no-elevate.mjs",
    "verify": "node scripts/verify-all.mjs",
    "release:app-update-yml": "node scripts/write-app-update-yml.mjs",
    "release:refresh-metadata": "node scripts/refresh-release-metadata.mjs",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "pdfjs-dist": "6.3.289",
    "tesseract.js": "7.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
