# dependencies
node_modules/
.pnp
.pnp.js

# build output
out/
dist/
# NOTE: build/ is NOT ignored. In electron-builder that directory holds build *resources* — the
# application icons, the macOS entitlements, the NSIS include — and every one of them is source.
# It was ignored here as if it were build output, which cost the project both its icon ("default
# Electron icon is used" in every CI build) and, once the NSIS include arrived, the ability to
# package for Windows at all. Build output goes to out/, dist/ and release/, which are below.
release/
*.tsbuildinfo

# electron-builder
app-update.yml
*.exe
*.dmg
*.zip
*.blockmap
latest*.yml

# native module build artifacts
prebuilds/
*.node

# test output
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# local data that must never be committed
models/
fixtures/private/
*.sqlite
*.sqlite-wal
*.sqlite-shm
loadtest-data/

# scratch files from local debugging
/shot.mjs
/dbg*.mjs

# editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# logs and env
logs/
*.log
npm-debug.log*
.env
.env.*
!.env.example

# CI / local caches
.cache/

# Written by the release gate; the numbers belong in a release note, not in git
loadtest-report.json
performance-profile.json
