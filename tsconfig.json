{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@platform/*": ["./src/platform/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "*.config.ts"]
}
