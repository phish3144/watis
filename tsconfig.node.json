{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@platform/*": ["./src/platform/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/workers/**/*",
    "src/shared/**/*",
    "src/platform/**/*",
    "test/**/*",
    "scripts/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
